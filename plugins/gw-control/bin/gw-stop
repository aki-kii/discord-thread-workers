#!/bin/sh
# GW を止める。--workers を付けると worker も全部止める。会話は残る。

set -eu
. "$(dirname "$0")/gw-common.sh"

load_config

found=$(agent_by_name "$CFG_GW_NAME" || true)
if [ -z "$found" ]; then
  printf 'GW はいません。\n'
elif [ "$(printf '%s' "$found" | cut -f1)" = stopped ]; then
  printf 'GW はすでに停止しています (%s)。\n' "$(printf '%s' "$found" | cut -f2)"
else
  id=$(printf '%s' "$found" | cut -f2)
  claude stop "$id" >/dev/null 2>&1 || true
  printf 'GW を止めました (%s)。会話は残っています。\n' "$id"
fi

[ "${1:-}" = "--workers" ] || exit 0

# 名前だけでなく、控えてあるセッション ID でも探す。切り替え先のアカウントで再開した
# worker は、名前を自動で付け替えられることがある。名前だけで探すと止め損ね、
# 同じ会話を二つのアカウントのプロセスが握ったまま残る。
claude agents --json 2>/dev/null | python3 -c '
import json, sys
try:
    rows = json.load(sys.stdin)
except Exception:
    rows = []
try:
    with open(sys.argv[1]) as f:
        known = {e.get("sessionId") for e in json.load(f).values()}
except Exception:
    known = set()
for a in rows if isinstance(rows, list) else []:
    if not a.get("pid"):
        continue
    if (a.get("name") or "").startswith("thread-") or a.get("sessionId") in known:
        print(a.get("id"))
' "$DTW_HOME/workers.json" | while read -r wid; do
  [ -n "$wid" ] || continue
  claude stop "$wid" >/dev/null 2>&1 || true
  printf 'worker を止めました (%s)。\n' "$wid"
done
